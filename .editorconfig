root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = android_studio
ktlint_standard_no-wildcard-imports = enabled

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
