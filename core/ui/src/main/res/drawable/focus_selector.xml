<?xml version="1.0" encoding="utf-8"?>
<!-- The one focus highlight for the whole app (AGENTS.md §4, UX-SPEC §2):
     full-width inverse block + 2 dp border, no rounded corners, no ripple.
     Never write a per-screen focus highlight. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
            <stroke
                android:width="@dimen/focus_border_width"
                android:color="@color/focus_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
            <stroke
                android:width="@dimen/focus_border_width"
                android:color="@color/focus_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
