<?xml version="1.0" encoding="utf-8"?>
<!-- The softkey bar (UX-SPEC §1): three cells on the inverse surface, 11 sp.
     LEFT = Options, CENTRE = activate, RIGHT = Back — always (AGENTS.md §4).
     Not focusable: it is a label strip driven by the hardware keys, never tapped. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/softkey_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="4dp"
        android:textColor="@color/text_on_inverse"
        android:textSize="@dimen/text_meta"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Options" />

    <TextView
        android:id="@+id/softkey_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/text_on_inverse"
        android:textStyle="bold"
        android:textSize="@dimen/text_meta"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Select" />

    <TextView
        android:id="@+id/softkey_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|end"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/content_pad"
        android:textColor="@color/text_on_inverse"
        android:textSize="@dimen/text_meta"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Back" />
</merge>
