<?xml version="1.0" encoding="utf-8"?>
<!-- The softkey bar (UX-SPEC §1): three cells on the accent surface
     (SoftkeyBarView sets the background to ?attr/colorFocusAccent —
     Phase 4 of the UI improvement plan), ?attr/textSizeSoftkey (13/16/20 sp
     with Settings > Text size — its own role, not the shared text_meta).
     LEFT = Options, CENTRE = activate, RIGHT = Back — always (AGENTS.md §4).
     Not focusable: it is a label strip driven by the hardware keys, never
     D-pad-focused, only (optionally) tapped. android:focusable="false" is
     REQUIRED here, explicitly, on each cell, not just on the container
     (SoftkeyBarView sets isFocusable=false on itself, which does not cascade
     to its children) — a confirmed bug: SoftkeyBarView.render() sets
     isClickable=true on a non-blank cell, and since API 26 a clickable View
     with no explicit focusable value becomes focusable automatically. That
     let a softkey cell (typically CENTER, "Select") win D-pad focus-search
     over compose_input from the last timeline row, instead of being skipped
     as chrome. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/softkey_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/softkey_cell_background"
        android:gravity="center_vertical|start"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="4dp"
        android:textColor="?attr/colorTextOnInverse"
        android:textSize="?attr/textSizeSoftkey"
        android:maxLines="1"
        android:ellipsize="end"
        android:focusable="false"
        android:focusableInTouchMode="false"
        tools:text="Options" />

    <TextView
        android:id="@+id/softkey_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/softkey_cell_background"
        android:gravity="center"
        android:textColor="?attr/colorTextOnInverse"
        android:textStyle="bold"
        android:textSize="?attr/textSizeSoftkey"
        android:maxLines="1"
        android:ellipsize="end"
        android:focusable="false"
        android:focusableInTouchMode="false"
        tools:text="Select" />

    <TextView
        android:id="@+id/softkey_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/softkey_cell_background"
        android:gravity="center_vertical|end"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/content_pad"
        android:textColor="?attr/colorTextOnInverse"
        android:textSize="?attr/textSizeSoftkey"
        android:maxLines="1"
        android:ellipsize="end"
        android:focusable="false"
        android:focusableInTouchMode="false"
        tools:text="Back" />
</merge>
