    <style name="Theme.MatChat.Accent.MatChat" parent="">
        <item name="colorFocusAccent">@color/accent_matchat</item>
        <item name="colorAccent">?attr/colorFocusAccent</item>
        <item name="colorSurfaceFocused">@color/accent_matchat_tint</item>
        <item name="colorBubbleOwn">@color/accent_matchat_tint</item>
    </style>
