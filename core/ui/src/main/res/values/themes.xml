    <!-- Manifest default / fallback — see the file header. Baked with the
         Normal (large) size set and the MatChat (icon indigo) accent, matching the default
         preferences (SharedPreferencesUserPreferences). -->
    <style name="Theme.MatChat" parent="Theme.MatChat.Base.Light">
        <item name="colorFocusAccent">@color/accent_matchat</item>
        <item name="colorAccent">?attr/colorFocusAccent</item>
        <item name="colorSurfaceFocused">@color/accent_matchat_tint</item>
        <item name="colorBubbleOwn">@color/accent_matchat_tint</item>
        <item name="textSizeBody">@dimen/text_body_large</item>
        <item name="textSizeLabel">@dimen/text_label_large</item>
        <item name="textSizeMeta">@dimen/text_meta_large</item>
        <item name="textSizeRoomName">@dimen/text_room_name_large</item>
        <item name="textSizeRoomPreview">@dimen/text_room_preview_large</item>
