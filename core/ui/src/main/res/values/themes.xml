<?xml version="1.0" encoding="utf-8"?>
<!-- Base theme for MatChat. AppCompat, not Material: Views deliberately
     (docs/adr/0002). No ripples, no elevation, no animation over 150 ms.

     Theme.MatChat.Base.{Light,Dark} carry every role attr (attrs.xml) that
     does NOT depend on the user's chosen accent or size. Accent is layered
     on top at runtime via Resources.Theme.applyStyle(resId, force = true)
     (MainActivity.onCreate()) — the same "ThemeOverlay" pattern Android
     itself uses — rather than as part of a combined leaf: Theme.MatChat.
     Accent.<Name> below are 16 standalone (parent="") overlays, one per
     Settings > Theme > Accent color choice, each carrying only the roles
     that vary by accent: colorFocusAccent (the trailing-edge focus bar and
     the chrome bars), colorAccent (AppCompat's own tint), and
     colorSurfaceFocused + colorBubbleOwn (both a translucent wash of the
     SAME accent, colors.xml's accent_<name>_tint — every "light shade of
     the accent" role in the app must be one of these two attrs, not a
     fixed hex, or it silently stops tracking the user's theme choice; that
     was a real bug here twice, on both of these, before this fix). Kept
     flat (16) rather than combined with the base (which would be 32, and
     64 once text size — also layered this way, see Theme.MatChat.Size.*
     below — is folded in) so this list doesn't grow with the number of
     bases or sizes. Theme.MatChat itself is the manifest/default fallback
     for any context built before the stored preference is read
     (MainActivity always calls setTheme() + applyStyle() with the resolved
     layers first, so this is a safety net, not the normal path) — fully
     baked (Base.Light + Green), not a bare alias to an overlay, since an
     overlay's parent="" means it resolves nothing on its own. -->
<resources>
    <style name="Theme.MatChat.Base.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorSurface">@color/palette_paper</item>
        <item name="colorSurfaceBright">@color/palette_paper_bright</item>
        <item name="colorSurfaceInverse">@color/palette_ink</item>
        <item name="colorTextPrimary">@color/palette_ink</item>
        <item name="colorTextSecondary">@color/palette_stone</item>
        <item name="colorTextOnInverse">@color/text_on_inverse</item>
        <item name="colorTextOnFocus">@color/text_on_focus</item>
        <item name="colorTextMetaOnFocus">@color/text_meta_on_focus</item>
        <item name="colorTextLink">@color/palette_amber</item>
        <item name="colorDivider">@color/palette_line</item>
        <item name="colorEncrypted">@color/palette_green</item>
        <item name="colorWarning">@color/warning</item>
        <item name="colorError">@color/error</item>
        <item name="colorScrim">@color/scrim</item>
        <item name="colorBubbleReceived">@color/palette_bubble_received_light</item>
        <item name="colorBubbleBorder">@color/palette_line</item>
        <item name="colorBubbleStripeVeil">@android:color/transparent</item>
        <item name="colorBubbleOwnVeil">@color/bubble_own_veil_light</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="android:textColorSecondary">?attr/colorTextSecondary</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- These are D-pad devices: never behave as if a touch is available. -->
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Mirrors Base.Light role for role, in TurboText's Classic Dark: a
         black surface, a #222 "raised panel" tone for dialogs, and brighter green/amber so
         the encrypted indicator and the link text keep their contrast
         against a dark surface (colors.xml). -->
    <style name="Theme.MatChat.Base.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorSurface">@color/palette_black</item>
        <item name="colorSurfaceBright">@color/palette_tt_surface</item>
        <item name="colorSurfaceInverse">@color/palette_tt_surface</item>
        <item name="colorTextPrimary">@color/palette_tt_white</item>
        <item name="colorTextSecondary">@color/palette_tt_grey</item>
        <item name="colorTextOnInverse">@color/text_on_inverse</item>
        <item name="colorTextOnFocus">@color/text_on_focus</item>
        <item name="colorTextMetaOnFocus">@color/text_meta_on_focus</item>
        <item name="colorTextLink">@color/palette_amber_bright</item>
        <item name="colorDivider">@color/palette_tt_raised</item>
        <item name="colorEncrypted">@color/palette_green_bright</item>
        <item name="colorWarning">@color/warning</item>
        <item name="colorError">@color/error</item>
        <item name="colorScrim">@color/scrim</item>
        <item name="colorBubbleReceived">@color/palette_tt_raised</item>
        <item name="colorBubbleBorder">@android:color/transparent</item>
        <item name="colorBubbleStripeVeil">@color/bubble_stripe_veil_dark</item>
        <item name="colorBubbleOwnVeil">@color/bubble_own_veil_dark</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="android:textColorSecondary">?attr/colorTextSecondary</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Accent overlays (parent="" — standalone, not inheriting any base;
