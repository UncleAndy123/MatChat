    <!-- Size overlays (parent="" — same standalone shape as the accent
         overlays above; layered on top of those via a second applyStyle()
         call, MainActivity.onCreate()). Settings > Text size (UX-SPEC §S16)
         switches between these three — every dimension role that scales
         with it lives here, nowhere else. Normal is the default set (the
         `_large` dimens — this app's whole point is legibility on a small
         screen, so "normal" should already read comfortably); Small is the
         reduced option, for anyone who wants more on screen at once; Large
         is a further step up (the `_xlarge` dimens) for anyone who wants it
         bigger still. -->
    <style name="Theme.MatChat.Size.Normal" parent="">
        <item name="textSizeBody">@dimen/text_body_large</item>
        <item name="textSizeLabel">@dimen/text_label_large</item>
        <item name="textSizeMeta">@dimen/text_meta_large</item>
        <item name="textSizeRoomName">@dimen/text_room_name_large</item>
        <item name="textSizeRoomPreview">@dimen/text_room_preview_large</item>
        <item name="textSizeAddress">@dimen/text_address_large</item>
        <item name="textSizeSender">@dimen/text_sender_large</item>
        <item name="textSizeHeading">@dimen/text_heading_large</item>
        <item name="avatarSizeList">@dimen/avatar_size_list_large</item>
        <item name="avatarSizeSender">@dimen/avatar_size_sender_large</item>
        <item name="avatarSizeSeenBy">@dimen/avatar_size_seen_by_large</item>
        <item name="rowMinHeight">@dimen/row_min_height_large</item>
        <item name="rowMinHeightCompact">@dimen/row_min_height_compact_large</item>
        <item name="textSizeSoftkey">@dimen/text_softkey_label_large</item>
        <item name="softkeyBarHeight">@dimen/softkey_bar_height_large</item>
        <item name="titleBarHeight">@dimen/title_bar_height_large</item>
