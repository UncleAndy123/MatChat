<?xml version="1.0" encoding="utf-8"?>
<!-- Type floor (PLAN.md G5, UX-SPEC §2): body 16 sp · interactive labels 14 sp ·
     secondary metadata 11 sp. Nothing a user reads goes below 11 sp. -->
<resources>
    <!-- Text sizes. Each role here has a Large counterpart below (Settings > Text size, UX-SPEC
         §S16), surfaced through the matching textSize<Role> attr
         (attrs.xml/themes.xml), never referenced directly by a layout. -->
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_meta">11sp</dimen>
    <dimen name="text_room_name">16sp</dimen>
    <!-- item_room.xml's message preview — previously an orphan raw 13sp,
         promoted to a named role for the Text size round. -->
    <dimen name="text_room_preview">13sp</dimen>
    <!-- The full-address display text (fragment_type_address.xml,
         fragment_invite_detail.xml) — UX-SPEC §S19 calls this out as its own
         role ("the full address... this is the thing the user is judging"),
         so it gets a dedicated dimen rather than reusing text_room_preview's
         (same Normal value today, but a coincidence, not a coupling). -->
    <dimen name="text_address">13sp</dimen>
    <dimen name="text_sender">12sp</dimen>
    <dimen name="text_heading">17sp</dimen>
    <!-- Softkey bar labels only (view_softkey_bar.xml) — a dedicated size,
         not text_meta's: timestamps/day-separators/sender names also use
         that and UX-SPEC.md specifies them separately. Scales with Text
         size like everything else (?attr/textSizeSoftkey: 13/16/20 sp),
         per explicit user direction; softkey_bar_height grows to match. -->
    <dimen name="text_softkey_label">13sp</dimen>
    <dimen name="text_softkey_label_large">16sp</dimen>
    <dimen name="text_softkey_label_xlarge">20sp</dimen>

    <!-- Text size setting: the larger set, used by default (Theme.MatChat.
         Size.Normal — Settings > Text size, UX-SPEC §S16 — explicit values
         there; the rest extrapolated at roughly the same ratio). The
         un-suffixed dimens above are the smaller set, used only by
         Theme.MatChat.Size.Small. -->
    <dimen name="text_body_large">20sp</dimen>
    <dimen name="text_label_large">18sp</dimen>
    <dimen name="text_meta_large">14sp</dimen>
    <dimen name="text_room_name_large">21sp</dimen>
    <dimen name="text_room_preview_large">16sp</dimen>
    <dimen name="text_address_large">16sp</dimen>
    <dimen name="text_sender_large">15sp</dimen>
    <dimen name="text_heading_large">21sp</dimen>

    <!-- Text size setting: a third, larger-still tier (Theme.MatChat.
         Size.Large — Settings > Text size), one more ~1.25x step above the
         _large set (which "Normal" already claims — see that set's own
         comment on the naming). -->
    <dimen name="text_body_xlarge">25sp</dimen>
    <dimen name="text_label_xlarge">22sp</dimen>
    <dimen name="text_meta_xlarge">17sp</dimen>
    <dimen name="text_room_name_xlarge">26sp</dimen>
    <dimen name="text_room_preview_xlarge">20sp</dimen>
    <dimen name="text_address_xlarge">20sp</dimen>
    <dimen name="text_sender_xlarge">19sp</dimen>
    <dimen name="text_heading_xlarge">26sp</dimen>

    <!-- Chrome bands (UX-SPEC §1), one height per Text size (via
         ?attr/titleBarHeight / ?attr/softkeyBarHeight; un-suffixed = Small,
         _large = Normal, _xlarge = Large, like the text sizes). The title is
         ?attr/textSizeLabel (14/18/22 sp), centred and bold; the softkey
         labels are text_softkey_label (13/16/20 sp). -->
    <dimen name="title_bar_height">24dp</dimen>
    <dimen name="title_bar_height_large">28dp</dimen>
    <dimen name="title_bar_height_xlarge">34dp</dimen>
    <dimen name="softkey_bar_height">24dp</dimen>
    <dimen name="softkey_bar_height_large">26dp</dimen>
    <dimen name="softkey_bar_height_xlarge">32dp</dimen>

    <!-- Rows use minHeight, never a fixed height (UX-SPEC S16), specifically
         so they're free to grow at the largest font scale (AGENTS.md). -->
    <dimen name="row_min_height">44dp</dimen>
    <dimen name="row_min_height_compact">36dp</dimen>
    <dimen name="row_min_height_large">64dp</dimen>
    <dimen name="row_min_height_compact_large">52dp</dimen>
    <dimen name="row_min_height_xlarge">80dp</dimen>
    <dimen name="row_min_height_compact_xlarge">65dp</dimen>

    <!-- Focus highlight: trailing-edge accent bar width, no rounded corners
         (UX-SPEC §2). Widened from 3dp after the first pass read as barely
         visible against the subtle fill. -->
    <dimen name="focus_bar_width">6dp</dimen>

    <dimen name="content_pad">8dp</dimen>

    <!-- S9 message bubbles (item_message.xml, item_message_image.xml). Max
         width reaches nearly the full row width (reference-device
         screenshot — only a hairline gap on the unoccupied side), on the
         240dp-wide reference portrait viewport (PLAN.md §8.2) — this app
         targets one fixed screen class, not a range, so a dp cap (not a
         percentage) matches every other dimension here. Fully rounded, with
         the accent stripe running inside the rounded outline on the sender's
         side (TurboText, per the user's reference clip). -->
    <dimen name="bubble_corner_radius">12dp</dimen>
    <!-- Accent stripe on the leading/trailing edge (own messages: trailing;
         received: leading — both get one). -->
    <dimen name="bubble_stripe_width">5dp</dimen>
    <dimen name="bubble_max_width">220dp</dimen>
    <dimen name="bubble_pad_h">10dp</dimen>
    <dimen name="bubble_pad_v">6dp</dimen>
    <!-- The little tail off the bottom corner on the sender's side
         (BubbleDrawable, TurboText), and the bottom padding that keeps
         content clear of it: bubble_pad_v + bubble_tail_height. -->
    <dimen name="bubble_tail_width">8dp</dimen>
    <dimen name="bubble_tail_height">6dp</dimen>
    <dimen name="bubble_pad_bottom">12dp</dimen>
    <!-- Border-based focus cue (replaces the row-wide flat fill for message
         bubbles specifically — AGENTS.md §4 exception, see its note). -->
    <dimen name="bubble_border_width">1dp</dimen>
    <dimen name="bubble_border_width_focused">2.5dp</dimen>

    <!-- Avatars round: a placeholder/decoded circle next to a name. Three
         sizes for three contexts — a room-list row (item_room.xml,
         row_min_height), a message sender (item_message.xml/
         item_message_image.xml, next to the 12sp text_sender line), and the
         small "seen by" row underneath an own message. -->
    <dimen name="avatar_size_list">32dp</dimen>
    <dimen name="avatar_size_sender">16dp</dimen>
    <dimen name="avatar_size_seen_by">14dp</dimen>

    <!-- Text size setting: Large counterparts, same ~1.44-1.45x ratio as the
         row-height growth above (UX-SPEC §S16). -->
    <dimen name="avatar_size_list_large">44dp</dimen>
    <dimen name="avatar_size_sender_large">24dp</dimen>
    <dimen name="avatar_size_seen_by_large">20dp</dimen>

    <!-- Text size setting: Large tier's avatar counterparts, same ~1.25x step. -->
    <dimen name="avatar_size_list_xlarge">55dp</dimen>
    <dimen name="avatar_size_sender_xlarge">30dp</dimen>
    <dimen name="avatar_size_seen_by_xlarge">25dp</dimen>
</resources>
