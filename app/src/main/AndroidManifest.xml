<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Sync runs as a dataSync foreground service (PLAN.md §6.6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Runtime notification permission on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Recording voice notes (S9); the mic is optional hardware. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Call audio routing (earpiece/speaker) for LiveKit voice calls (ADR 0006). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Full-screen incoming-call ring over the lock screen / closed flip (VOICE §5). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Keep sync alive on idle; some carrier builds refuse it (PLAN.md §6.6). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Save a received image to the gallery / an attachment to Downloads
         (S9/S11). Only needed on API 24–28; API 29+ uses scoped-storage
         MediaStore with no permission, so this is capped at 28. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Recover a just-taken photo from the gallery when the camera app ignores
         our EXTRA_OUTPUT file (Take photo, S9; findLatestCameraImage). Media-read
         is READ_MEDIA_IMAGES on API 33+, READ_EXTERNAL_STORAGE below that. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Install a downloaded update APK from Settings > Software update
         (:core:update). The user still confirms each install, and on API 26+
         must grant "install unknown apps" to MatChat first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No Google Play Services on these devices (PLAN.md §3). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Apps we hand an implicit intent to. On Android 11+ (targetSdk 30+)
         package visibility hides other apps unless declared here, so without
         this the camera can't resolve and "Take photo" (S9) fails with
         ActivityNotFoundException ("No app on this phone can open this file").
         A default SMS app like DPAD-Messaging gets this visibility from its
         role; MatChat, a normal app, must declare it. -->
    <queries>
        <!-- Take photo: launch the device camera (ACTION_IMAGE_CAPTURE). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Open a downloaded/saved attachment in the system viewer. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".MatChatApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MatChat"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Optional, user-enabled workaround for a device whose predictive-text
             keyboard consumes the right softkey before this app sees it while
             composing — see MatChatKeyAccessibilityService's own doc comment.
             Enabled manually in Settings > Accessibility; inert otherwise.
             exported="true" matches a confirmed-working sibling app's own
             accessibility service on this hardware family (TurboText) — the
             android.permission.BIND_ACCESSIBILITY_SERVICE requirement below
             is what actually gates binding (only the system holds it), not
             this attribute, so this isn't a security relaxation. -->
        <service
            android:name=".accessibility.MatChatKeyAccessibilityService"
            android:exported="true"
            android:label="@string/key_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice.AccessibilityService"
                android:resource="@xml/key_accessibility_service_config" />
        </service>

        <!-- Notification action handlers (inline reply, mark as read). -->
        <receiver android:name=".notify.MessageReplyReceiver" android:exported="false" />
        <receiver android:name=".notify.MarkReadReceiver" android:exported="false" />
        <receiver android:name=".notify.CallActionReceiver" android:exported="false" />

        <!-- Hands downloaded attachments to the system viewer, and
             silence-prefixed notification sounds to NotificationManager,
             via content:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Managed configuration schema (docs/MDM.md §3). Only :core:policy reads it. -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <!-- On-demand WorkManager init: MatChatApp is the Configuration.Provider
             (Hilt supplies the worker factory for SyncWorker), so the default
             startup initializer must be removed (ADR 0004 fallback). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
