<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths: downloaded attachments handed to the system viewer,
     and (notification_sounds) silence-prefixed notification sounds handed
     to NotificationChannel.setSound() (SilentLeadInSound). -->
<paths>
    <cache-path name="media" path="media/" />
    <cache-path name="notification_sounds" path="notification_sounds/" />
    <!-- Downloaded update APKs handed to the system installer (:core:update). -->
    <cache-path name="updates" path="updates/" />
</paths>
