<?xml version="1.0" encoding="utf-8"?>
<!-- S28 Join group: a room linked in a message. The address wraps and is never
     truncated. One action button (Join / Ask to join / Open), hidden when there
     is nothing to do (blocked by policy, invite-only, request already sent). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/content_pad">

        <TextView
            android:id="@+id/join_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="?attr/textSizeHeading"
            android:textColor="?attr/colorTextPrimary"
            tools:text="Barn Crew" />

        <TextView
            android:id="@+id/join_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeAddress"
            android:textColor="?attr/colorTextPrimary"
            tools:text="#barn:example.org" />

        <TextView
            android:id="@+id/join_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            tools:text="12 members" />

        <TextView
            android:id="@+id/join_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textSize="?attr/textSizeAddress"
            android:textColor="?attr/colorTextPrimary"
            tools:text="Chores, rides and supper plans." />

        <TextView
            android:id="@+id/join_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/join_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="?attr/textSizeAddress"
            android:textColor="?attr/colorTextPrimary"
            android:visibility="gone"
            tools:text="@string/join_note_needs_invite"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/join_blocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="?attr/textSizeAddress"
            android:textColor="?attr/colorWarning"
            android:visibility="gone"
            tools:text="Your organization does not allow messages from example.org." />

        <TextView
            android:id="@+id/join_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <TextView
            android:id="@+id/join_action"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus"
            android:visibility="gone"
            tools:text="@string/join_button_ask"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
