<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Notifications. Two focusable rows: a toggle (checkmark on its
     label, same convention as Advanced/Theme) and a Sound row that launches
     the system ringtone picker, its subtitle showing the current choice.
     Then a note pointing to per-room sounds in Room info (S12). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad">

        <TextView
            android:id="@+id/notifications_enabled"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp"
            android:text="@string/notifications_enabled_sub" />

        <TextView
            android:id="@+id/notifications_sound"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications_sound"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/notifications_sound_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp" />

        <!-- Per-room sounds live in Room info (S12); this says where. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="8dp"
            android:text="@string/notifications_room_sound_note" />

        <!-- Android 7–9, storage access refused: MatChat's own sounds are
             missing from the picker (docs/SOUNDS.md). -->
        <TextView
            android:id="@+id/notifications_bundled_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:visibility="gone"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="8dp"
            android:text="@string/notifications_bundled_access" />

        <!-- Privacy toggle for the Kyocera cover-screen card
             (docs/COVER-DISPLAY.md): checkmark when the card shows only a
             generic "MatChat message". Last, after the sound notes. -->
        <TextView
            android:id="@+id/notifications_cover_hidden"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp"
            android:text="@string/notifications_cover_hidden_sub" />
    </LinearLayout>
</ScrollView>
