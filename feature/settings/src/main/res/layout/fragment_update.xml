<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Software update. A status line + version lines + release notes,
     then one focusable action row whose label and behaviour depend on the
     phase (Check / Download / Install), CENTER (or tap) runs it. Selection and
     progress are shown as text, never color alone (AGENTS.md). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad">

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/update_versions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:paddingBottom="8dp"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary" />

        <TextView
            android:id="@+id/update_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:visibility="gone"
            android:paddingBottom="8dp"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary" />

        <TextView
            android:id="@+id/update_action"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />
    </LinearLayout>
</ScrollView>
