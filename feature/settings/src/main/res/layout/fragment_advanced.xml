<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Advanced (Phase 6, UI improvement plan; docs/adr/0007). The
     swap toggle: CENTER (or a tap) flips it. The selected state is a
     trailing checkmark on the label (theme_row_selected_format, shared with
     S24 Theme), never color alone (AGENTS.md). Then "Run in background"
     (opens the system battery-optimization dialog) and the background helper
     (opens system Accessibility settings for MatChatKeyAccessibilityService —
     the softkey workaround while composing, and the host that lets sync run
     without the "MatChat is running" notification, docs/adr/0008). Both are
     system settings, not ours, so they are action rows with a read-only
     status line under each, not toggles. Focus order = XML order:
     swap → run in background → helper. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_pad"
        android:paddingEnd="@dimen/content_pad">

        <TextView
            android:id="@+id/advanced_swap_softkeys"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="@string/advanced_swap_softkeys_sub" />

        <TextView
            android:id="@+id/advanced_battery_row"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_battery_row"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:id="@+id/advanced_battery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/advanced_accessibility_row"
            style="@style/Widget.MatChat.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_accessibility_row"
            android:textSize="?attr/textSizeLabel"
            android:textColor="?attr/colorTextOnFocus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp"
            android:text="@string/advanced_accessibility_row_sub" />

        <TextView
            android:id="@+id/advanced_accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textSize="?attr/textSizeMeta"
            android:textColor="?attr/colorTextSecondary"
            android:paddingStart="@dimen/content_pad"
            android:paddingEnd="@dimen/content_pad"
            android:paddingTop="2dp" />
    </LinearLayout>
</ScrollView>
