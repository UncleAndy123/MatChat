<?xml version="1.0" encoding="utf-8"?>
<!-- S3 Sign in. Focus order: Username → Password → Sign in. Homeserver row is
     read-only (not focusable) when pinned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/content_pad">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signin_homeserver_label"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextSecondary" />

    <EditText
        android:id="@+id/homeserver_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="textUri"
        android:importantForAutofill="no"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextPrimary"
        tools:text="chats.carpathianserver.org" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/signin_username"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextSecondary" />

    <EditText
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="text"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextPrimary"
        android:hint="@string/signin_username" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/signin_password"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextSecondary" />

    <!-- textVisiblePassword, not textPassword: on the keypad IMEs these phones
         ship, the password variation forces alpha multi-tap and swallows the
         number keys, so a password containing digits can't be typed. The
         masking is restored in code with a PasswordTransformationMethod (the
         IME reads inputType, the view reads the transformation), so the field
         still shows dots. Same reason the recovery-key field uses it. -->
    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="textVisiblePassword"
        android:importantForAutofill="no"
        android:textSize="?attr/textSizeBody"
        android:textColor="?attr/colorTextPrimary"
        android:hint="@string/signin_password" />

    <!-- Directly below the password: a focus stop that toggles masking. Label
         text is set in render() from state.showPassword. -->
    <TextView
        android:id="@+id/toggle_password"
        style="@style/Widget.MatChat.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signin_show_password"
        android:textSize="?attr/textSizeLabel"
        android:textColor="?attr/colorTextOnFocus" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sign_in_button"
        style="@style/Widget.MatChat.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/signin_submit"
        android:textSize="?attr/textSizeLabel"
        android:textColor="?attr/colorTextOnFocus" />
</LinearLayout>
