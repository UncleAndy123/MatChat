<?xml version="1.0" encoding="utf-8"?>
<!-- S3 Sign in. Focus order: Username → Password → Sign in. Homeserver row is
     read-only (not focusable) when pinned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/content_pad">

    <TextView
        android:id="@+id/homeserver_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:textSize="@dimen/text_meta"
        android:textColor="@color/text_secondary"
        tools:text="🔒 chats.carpathianserver.org" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/signin_username"
        android:textSize="@dimen/text_meta"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="text"
        android:autofillHints="username"
        android:importantForAutofill="no"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_primary"
        android:hint="@string/signin_username" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/signin_password"
        android:textSize="@dimen/text_meta"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="textPassword"
        android:importantForAutofill="no"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_primary"
        android:hint="@string/signin_password" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="@dimen/text_meta"
        android:textColor="@color/error"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sign_in_button"
        style="@style/Widget.MatChat.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/signin_submit"
        android:textSize="@dimen/text_label"
        android:textColor="@color/text_on_focus" />
</LinearLayout>
