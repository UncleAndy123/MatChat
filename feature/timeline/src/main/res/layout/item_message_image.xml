<?xml version="1.0" encoding="utf-8"?>
<!-- An inline image message (S9). Same bubble treatment as item_message.xml,
     including its focus-via-border exception (see its header comment) and
     its Avatars-round sender_avatar/seen_by additions; the image itself
     keeps its own 200dp cap (downsampled to the QVGA screen) rather than
     bubble_max_width, so an image bubble can sit a little wider than a text
     one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minHeight="?attr/rowMinHeightCompact"
    android:paddingStart="@dimen/content_pad"
    android:paddingEnd="@dimen/content_pad"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/image_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:duplicateParentState="true"
        android:paddingStart="@dimen/bubble_pad_h"
        android:paddingEnd="@dimen/bubble_pad_h"
        android:paddingTop="@dimen/bubble_pad_v"
        android:paddingBottom="@dimen/bubble_pad_bottom">

        <LinearLayout
            android:id="@+id/image_sender_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:duplicateParentState="true"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/image_sender_avatar"
                android:layout_width="?attr/avatarSizeSender"
                android:layout_height="?attr/avatarSizeSender"
                android:layout_marginEnd="4dp"
                android:src="@drawable/avatar_placeholder"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/image_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:maxWidth="@dimen/bubble_max_width"
                android:textSize="?attr/textSizeSender"
                android:textColor="?attr/colorEncrypted"
                tools:text="Wayne" />
        </LinearLayout>

        <ImageView
            android:id="@+id/message_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:maxHeight="200dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/timeline_image"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/image_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:maxWidth="@dimen/bubble_max_width"
            android:textSize="?attr/textSizeBody"
            android:textColor="?attr/colorTextOnFocus"
            android:visibility="gone"
            tools:text="At the north gate" />
    </LinearLayout>

    <TextView
        android:id="@+id/image_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="1dp"
        android:duplicateParentState="true"
        android:textSize="?attr/textSizeMeta"
        android:textColor="?attr/colorTextMetaOnFocus"
        tools:text="3:42 PM ✓✓" />

    <LinearLayout
        android:id="@+id/image_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/image_seen_by"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
