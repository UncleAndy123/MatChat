<?xml version="1.0" encoding="utf-8"?>
<!-- S7 Recovery-key entry. Enter the admin-issued recovery key to restore keys
     so encrypted history can be read. Focus order: field → Verify. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/content_pad">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/verify_heading"
        android:textStyle="bold"
        android:textSize="@dimen/text_heading"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/verify_recovery_explanation"
        android:textSize="@dimen/text_meta"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/recovery_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:inputType="textVisiblePassword"
        android:importantForAutofill="no"
        android:hint="@string/verify_recovery_hint"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/verify_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_meta"
        android:textColor="@color/error"
        android:visibility="gone"
        android:text="@string/verify_error" />

    <TextView
        android:id="@+id/verify_button"
        style="@style/Widget.MatChat.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/verify_continue"
        android:textSize="@dimen/text_label"
        android:textColor="@color/text_on_focus" />
</LinearLayout>
